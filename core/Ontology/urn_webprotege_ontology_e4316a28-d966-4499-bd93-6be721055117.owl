    <!-- http://graph.clouditor.io/classes/AutomaticUpdates -->

    <owl:Class rdf:about="http://graph.clouditor.io/classes/AutomaticUpdates">
        <rdfs:subClassOf rdf:resource="http://graph.clouditor.io/classes/Integrity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/classes/securityOnly"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/properties/enabled"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/classes/interval"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">xsd:java.time.Duration</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This feature is, e.g., available on some VM services to automatically update their software. It ensures that a resource is protected from tampering with its state.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AutomaticUpdates</rdfs:label>
    </owl:Class>



    <!-- http://graph.clouditor.io/classes/Availability -->

    <owl:Class rdf:about="http://graph.clouditor.io/classes/Availability">
        <rdfs:subClassOf rdf:resource="http://graph.clouditor.io/classes/SecurityFeature"/>
        <rdfs:label xml:lang="english">Availability</rdfs:label>
    </owl:Class>



    <!-- http://graph.clouditor.io/classes/Backup -->

    <owl:Class rdf:about="http://graph.clouditor.io/classes/Backup">
        <rdfs:subClassOf rdf:resource="http://graph.clouditor.io/classes/Availability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/classes/offersInterface"/>
                <owl:someValuesFrom rdf:resource="http://graph.clouditor.io/classes/TransportEncryption"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/properties/has"/>
                <owl:someValuesFrom rdf:resource="http://graph.clouditor.io/classes/Storage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/properties/enabled"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/classes/interval"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">xsd:java.time.Duration</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/classes/retentionPeriod"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">xsd:java.time.Duration</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RetentionPeriod in hours</rdfs:comment>
        <rdfs:label xml:lang="english">Backup</rdfs:label>
    </owl:Class>



    <!-- http://graph.clouditor.io/classes/BaseResource -->

    <owl:Class rdf:about="http://graph.clouditor.io/classes/BaseResource">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/properties/parent"/>
                <owl:someValuesFrom rdf:resource="http://graph.clouditor.io/classes/BaseResource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/classes/creation_time"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/classes/description"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/classes/id"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/classes/name"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/classes/raw"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
