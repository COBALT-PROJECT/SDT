        <rdfs:subClassOf rdf:resource="http://graph.clouditor.io/classes/SecurityFeature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/classes/contextIsChecked"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="english">Authenticity</rdfs:label>
