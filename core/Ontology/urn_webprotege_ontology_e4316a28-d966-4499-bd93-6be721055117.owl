        <rdfs:label xml:lang="english">AccessRestriction</rdfs:label>
    </owl:Class>



    <!-- http://graph.clouditor.io/classes/Account -->

    <owl:Class rdf:about="http://graph.clouditor.io/classes/Account">
        <rdfs:subClassOf rdf:resource="http://graph.clouditor.io/classes/CloudResource"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This represents the cloud account as a whole, e.g., an Azure subscription.</rdfs:comment>
        <rdfs:label xml:lang="english">Account</rdfs:label>
    </owl:Class>



    <!-- http://graph.clouditor.io/classes/ActivityLog -->

    <owl:Class rdf:about="http://graph.clouditor.io/classes/ActivityLog">
        <rdfs:subClassOf rdf:resource="http://graph.clouditor.io/classes/Logging"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ActivityLogging</rdfs:label>
    </owl:Class>



    <!-- http://graph.clouditor.io/classes/AnomalyDetection -->

    <owl:Class rdf:about="http://graph.clouditor.io/classes/AnomalyDetection">
        <rdfs:subClassOf rdf:resource="http://graph.clouditor.io/classes/Auditing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/properties/offers"/>
                <owl:someValuesFrom rdf:resource="http://graph.clouditor.io/classes/ApplicationLog"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/classes/scope"/>
                <owl:hasValue rdf:resource="http://graph.clouditor.io/classes/resourceId"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/properties/enabled"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analyzes the activity of a NetworkService (which includes DatabaseServices).</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scope contains the resource ID of the protected resource.</rdfs:comment>
        <rdfs:label>AnomalyDetection</rdfs:label>
    </owl:Class>



    <!-- http://graph.clouditor.io/classes/Application -->

    <owl:Class rdf:about="http://graph.clouditor.io/classes/Application">
        <rdfs:subClassOf rdf:resource="http://graph.clouditor.io/classes/Component"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/properties/offers"/>
                <owl:someValuesFrom rdf:resource="http://graph.clouditor.io/classes/AutomaticUpdates"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/properties/runsOn"/>
                <owl:someValuesFrom rdf:resource="http://graph.clouditor.io/classes/Compute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/classes/programmingVersion"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/properties/programmingLanguage"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/properties/translationUnits"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#listString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This encapsulates the whole (source) code of an application.</rdfs:comment>
        <rdfs:label xml:lang="english">Application</rdfs:label>
    </owl:Class>



    <!-- http://graph.clouditor.io/classes/ApplicationLog -->

