    <!-- http://graph.clouditor.io/classes/TransportEncryption -->

    <owl:Class rdf:about="http://graph.clouditor.io/classes/TransportEncryption">
        <rdfs:subClassOf rdf:resource="http://graph.clouditor.io/classes/Confidentiality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/properties/hasMultiple"/>
                <owl:someValuesFrom rdf:resource="http://graph.clouditor.io/classes/CipherSuite"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/classes/protocol"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/classes/protocolVersion"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/properties/enabled"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://graph.clouditor.io/properties/enforced"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enabled means the resource _can_ be reached via https, while enforced means it _can only_ be reached via https (or http traffic is redirected)</rdfs:comment>
        <rdfs:label xml:lang="english">TransportEncryption</rdfs:label>
    </owl:Class>



