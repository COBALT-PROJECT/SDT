    <!-- http://graph.clouditor.io/classes/HttpEndpoint -->

    <owl:Class rdf:about="http://graph.clouditor.io/classes/HttpEndpoint">
        <rdfs:subClassOf rdf:resource="http://graph.clouditor.io/classes/Functionality"/>
